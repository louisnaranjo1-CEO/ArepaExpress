{
  "name": "un2x3-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/client/vite.config.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "dev:restaurant": "vite --config apps/restaurant/vite.config.ts",
    "dev:delivery": "vite --config apps/delivery/vite.config.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:waiter": "vite --config apps/waiter/vite.config.ts",
    "dev:cashier": "vite --config apps/cashier/vite.config.ts",
    "build": "vite build --config apps/client/vite.config.ts",
    "build:client": "vite build --config apps/client/vite.config.ts",
    "build:restaurant": "vite build --config apps/restaurant/vite.config.ts",
    "build:delivery": "vite build --config apps/delivery/vite.config.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:waiter": "vite build --config apps/waiter/vite.config.ts",
    "build:cashier": "vite build --config apps/cashier/vite.config.ts",
    "build:all": "npm run build:client && npm run build:restaurant && npm run build:delivery && npm run build:admin && npm run build:waiter && npm run build:cashier",
    "deploy": "npx wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/*/dist"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capgo/capacitor-native-biometric": "^8.4.2",
    "@google/genai": "^1.29.0",
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.9.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.13.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0",
    "wrangler": "^4.69.0"
  }
}
